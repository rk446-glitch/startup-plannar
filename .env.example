# PostgreSQL connection string from a managed database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to true only when the provider requires TLS for this connection.
DATABASE_SSL=false
# Optional additional allowed browser origin. Same-origin Vercel requests are checked automatically.
CLIENT_ORIGIN=https://your-project.vercel.app
NODE_ENV=production
# Optional local source file for one-time account migration; do not set this on Vercel.
AUTH_USERS_FILE=
