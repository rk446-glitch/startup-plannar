# Set to the Render Postgres internal connection string in the backend environment.
DATABASE_URL=postgresql://user:password@host:5432/database
# Enable only when the database connection requires TLS (for example an external DB URL).
DATABASE_SSL=false
# Set to the exact deployed Vercel origin, e.g. https://your-project.vercel.app.
CLIENT_ORIGIN=https://your-project.vercel.app
NODE_ENV=production
# Optional path to a local JSON account file for the one-time PostgreSQL migration.
AUTH_USERS_FILE=
